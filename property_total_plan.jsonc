// 3D plan of the back line at 8400 Candelaria Dr and the retail lot behind it.
// Started from the owner's spec and checked against the sources in local_source_registry
// (Oct 11 2026). Every entity names its source and accuracy. Claims that didn't hold up are
// listed under "removed_claims" instead of being modeled. tools/plan3d.py builds
// site/plan3d.obj from this file and adds our side (house, building B, septic, well, oak)
// from the repo's measured data.
{
  "project_meta": {
    "repository_target": "Granada Hills Property Addition Planning - 8400 Candelaria Dr",
    "units": "meters",
    "local_coordinate_origin": "Midpoint of the platted back (west) line of Lot 176, the line the retail lot adjoins",
    "axes": {
      "x": "along the back line, positive toward US-290 (NNE)",
      "y": "square to the back line, positive away from our lot (WNW, into the retail lot); our yard is y < 0",
      "z": "up"
    },
    "local_elevation_baseline": "z = 0 is the ground at the origin, 1048.7 ft NAVD88 (USGS lidar, +/-2 ft). Our yard is not level: it rises to ~1054-1056 ft by the house, and the back line falls from ~1050 ft at its north end to ~1047 ft at its south end.",
    "frame_accuracy": "Neighbor positions: +/-2 m from the parcel map, +/-8 m from the flyer's site-plan overlay. The repo's site frame uses the 1991 plat bearings, which run ~2 deg off the parcel map's back line."
  },

  "local_source_registry": {
    "parcel_survey_source": "tools/site_plan.py (1991 plat bearings and ties; the plat PDF stays out of this public repo)",
    "parcel_map": "Texas StratMap land parcels (Travis CAD, tax year 2026): Lot 176 Granada Hills Amended (ours); Lots 1A and 2A Blk A, Broadstone Scenic Brook Amd",
    "retail_flyer": "site/refs/scenic-brook-plaza-flyer.pdf",
    "terrain": "site/terrain-lidar.json",
    "interior_mesh_source": null // a CubiCasa room model would go in data/floorplans/ (git-ignored); none yet
  },

