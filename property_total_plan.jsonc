      "entity_id": "retail_lot_1a",
      "type": "parcel",
      "geometry": {
        "kind": "polygon",
        "points_m": [[15.3, -0.7], [-23.9, 0.0], [-63.1, 0.7], [-102.9, 1.4], [-142.7, 2.1], [-158.7, 2.4],
